# ============================================================
# UKSL Translator — Environment Configuration
# Copy to .env and adjust. Never commit the real .env file.
# ============================================================

# --- App ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- WebSocket ---
WS_MAX_MESSAGE_SIZE_BYTES=2097152   # 2 MB max per frame message
WS_MAX_FPS=15                       # server-side rate limit safeguard
WS_HEARTBEAT_INTERVAL_SEC=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Camera defaults (frontend) ---
CAMERA_FPS=12
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# --- ML model ---
MODEL_TYPE=lstm                     # lstm | transformer | video_jepa
MODEL_CHECKPOINT_PATH=models/checkpoints/baseline/latest.pt
MODEL_SEQUENCE_LENGTH=32
MODEL_DEVICE=cpu                    # cpu | cuda

# Feature toggles (must match configs/model.yaml)
FEATURES_HANDS=true
FEATURES_POSE=true
FEATURES_FACE=true

# --- NLP (Gloss -> Ukrainian text) ---
NLP_BACKEND=rule_based               # rule_based | huggingface
NLP_HF_MODEL_NAME=                   # e.g. a HF model repo id, if NLP_BACKEND=huggingface

# --- Text-to-Speech ---
TTS_PROVIDER=browser                 # browser | other (future)

# --- Speech-to-Text ---
STT_PROVIDER=browser                 # browser | whisper (future)

# --- Privacy / Security ---
STORE_RAW_VIDEO=false                # never store raw frames unless explicitly enabled
SEND_VIDEO_TO_THIRD_PARTY=false
